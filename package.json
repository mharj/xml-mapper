{
  "name": "@avanio/xml-mapper",
  "version": "0.1.7",
  "description": "XML schema mapping",
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        "import": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
        },
        "default": "./dist/index.mjs"
    },
  "scripts": {
    "build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean -c tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "lint": "biome check",
    "validate": "tsc --noEmit"
  },
  "repository": "github:mharj/xml-mapper",
  "files": [
    "dist"
  ],
  "keywords": [
    "xml",
    "mapping",
    "schema"
  ],
  "author": "mharj",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.6",
    "@types/xmldom": "^0.1.34",
    "@vitest/coverage-v8": "^5.0.1",
    "c8": "^12.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "xmldom": "^0.6.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
